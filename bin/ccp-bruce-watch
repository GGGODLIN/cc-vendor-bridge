#!/usr/bin/env bash
# ccp-bruce-watch — foreground health watcher for Bruce token proxy.
#
# Monitors /v1/pool/status healthPercent (no token cost; admin-exposed endpoint).
# Verified leading indicator 2026-06-20 (636-sample / 2h9min correlation run):
# messages stayed 100% 2xx while health swung 86.67% → 20%, so dropping health
# gives advance warning before user-facing 503.
#
# Pool size = 15 backing accounts (all observed health values are 6.67%
# multiples). Max ever seen: 86.67% (13/15 healthy; 2 always reserve/cooling).
# Min ever seen: 20% (3/15). The exact healthPercent → 503 threshold is still
# unverified (didn't hit 503 during the calibration run).
#
# Three thresholds (default tuned to the 86.67–20 observed range):
#   --warn-below N        yellow visual only, no notification (default 60)
#   --alert-below N       red + macOS notification (default 40)
#   --critical-below N    red bold + escalated notification (default 20)
#
# Each threshold fires once on cross-down. Recovery fires once when health
# climbs back above the alert threshold.
#
# Usage:
#   ccp-bruce-watch                              # 10s interval, default thresholds
#   ccp-bruce-watch --interval 5
#   ccp-bruce-watch --alert-below 50 --critical-below 30
#
# Stop: Ctrl-C / close terminal (SIGHUP) / kill -TERM. Trap prints a summary.
#
# Log: appends one JSON line per probe to ~/.claude/logs/bruce-pool-health.jsonl

set -uo pipefail

INTERVAL=10
TIMEOUT=8
WARN_BELOW=60
ALERT_BELOW=40
CRITICAL_BELOW=20
URL="https://bruce-token-proxy-2kjfv3lttq-de.a.run.app/v1/pool/status"
LOG_DIR="${HOME}/.claude/logs"
LOG_FILE="${LOG_DIR}/bruce-pool-health.jsonl"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --interval)        INTERVAL="$2";        shift 2 ;;
    --timeout)         TIMEOUT="$2";         shift 2 ;;
    --warn-below)      WARN_BELOW="$2";      shift 2 ;;
    --alert-below)     ALERT_BELOW="$2";     shift 2 ;;
    --critical-below)  CRITICAL_BELOW="$2";  shift 2 ;;
    -h|--help)
      sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "ccp-bruce-watch: unknown arg $1" >&2; exit 1 ;;
  esac
done

: "${BRUCE_API_KEY:?BRUCE_API_KEY not set; source shell/ccp-functions.sh first}"
command -v jq >/dev/null || { echo "ccp-bruce-watch: jq not found" >&2; exit 1; }

mkdir -p "$LOG_DIR"

if [[ -t 1 ]]; then
  C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YELLOW=$'\033[33m'
  C_DIM=$'\033[2m';    C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
  C_GREEN=; C_RED=; C_YELLOW=; C_DIM=; C_BOLD=; C_RESET=
fi

START_TS=$(date +%s)
START_HUMAN=$(date '+%H:%M:%S')
N_PROBE=0
N_ENDPOINT_ERR=0
HEALTH_MIN=100
HEALTH_MAX=0
HEALTH_SEEN=0
ALERT_FIRED=0
CRITICAL_FIRED=0
ENDPOINT_ALERTED=0

cleanup() {
  local elapsed=$(( $(date +%s) - START_TS ))
  echo
  printf '%s[ccp-bruce-watch stopped]%s started %s · ran %ds · %d probes · %d endpoint errors\n' \
    "$C_BOLD" "$C_RESET" "$START_HUMAN" "$elapsed" "$N_PROBE" "$N_ENDPOINT_ERR" >&2
  if [[ "$HEALTH_SEEN" == 1 ]]; then
    printf '  health observed: min=%s%% · max=%s%%\n' "$HEALTH_MIN" "$HEALTH_MAX" >&2
  fi
  printf '  log: %s\n' "$LOG_FILE" >&2
  exit 0
}
trap cleanup INT TERM HUP

notify() {
  local title="$1" msg="$2"
  osascript -e "display notification \"$msg\" with title \"$title\" sound name \"Sosumi\"" 2>/dev/null || true
}

printf '%s[ccp-bruce-watch]%s interval=%ds timeout=%ds · thresholds: warn<%d alert<%d critical<%d · log=%s · Ctrl-C to stop\n' \
  "$C_BOLD" "$C_RESET" "$INTERVAL" "$TIMEOUT" "$WARN_BELOW" "$ALERT_BELOW" "$CRITICAL_BELOW" "$LOG_FILE"

while true; do
  N_PROBE=$((N_PROBE + 1))
  ts_human=$(date '+%H:%M:%S')
  ts_iso=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

  body_file=$(mktemp /tmp/ccp-bruce-watch.XXXX)
  t0=$(date +%s%N)
  http_code=$(curl -sS -o "$body_file" -w "%{http_code}" \
    -m "$TIMEOUT" \
    -H "Authorization: Bearer $BRUCE_API_KEY" \
    "$URL" 2>/dev/null)
  t1=$(date +%s%N)
  [[ -z "$http_code" || ! "$http_code" =~ ^[0-9]{3}$ ]] && http_code="000"
  latency_ms=$(( (t1 - t0) / 1000000 ))
  health_raw=$(jq -r '.healthPercent // empty' "$body_file" 2>/dev/null)
  rm -f "$body_file"

  alert_suffix=""

  if [[ ! "$http_code" =~ ^2 ]] || [[ -z "$health_raw" ]]; then
    N_ENDPOINT_ERR=$((N_ENDPOINT_ERR + 1))
    health_arg="null"
    health_display="(no data)"
    color="$C_RED"
    if [[ "$ENDPOINT_ALERTED" == 0 ]]; then
      alert_suffix="  ${C_BOLD}→ ALERT pool/status endpoint failed${C_RESET}"
      notify "ccp-bruce endpoint down" "HTTP $http_code · /v1/pool/status unreachable"
      ENDPOINT_ALERTED=1
    fi
  else
    health_arg="$health_raw"
    health_display=$(printf '%6s%%' "$health_raw")
    HEALTH_SEEN=1
    HEALTH_MIN=$(jq -nr --argjson new "$health_raw" --argjson cur "$HEALTH_MIN" '[$new,$cur]|min')
    HEALTH_MAX=$(jq -nr --argjson new "$health_raw" --argjson cur "$HEALTH_MAX" '[$new,$cur]|max')

    if [[ "$ENDPOINT_ALERTED" == 1 ]]; then
      printf '%s[%s] endpoint recovered%s\n' "$C_BOLD" "$ts_human" "$C_RESET"
      notify "ccp-bruce endpoint recovered" "/v1/pool/status responding again"
      ENDPOINT_ALERTED=0
    fi

    lt_critical=$(jq -nr --argjson v "$health_raw" --argjson t "$CRITICAL_BELOW" '$v < $t')
    lt_alert=$(jq -nr --argjson v "$health_raw" --argjson t "$ALERT_BELOW" '$v < $t')
    lt_warn=$(jq -nr --argjson v "$health_raw" --argjson t "$WARN_BELOW" '$v < $t')

    if   [[ "$lt_critical" == "true" ]]; then color="${C_BOLD}${C_RED}"
    elif [[ "$lt_alert" == "true" ]];    then color="$C_RED"
    elif [[ "$lt_warn" == "true" ]];     then color="$C_YELLOW"
    else                                       color="$C_GREEN"
    fi

    if [[ "$lt_critical" == "true" && "$CRITICAL_FIRED" == 0 ]]; then
      alert_suffix="  ${C_BOLD}→ CRITICAL (health=${health_raw}% < ${CRITICAL_BELOW}%)${C_RESET}"
      notify "ccp-bruce CRITICAL" "healthPercent=$health_raw% (below $CRITICAL_BELOW% — past observed historic min, imminent 503 risk)"
      CRITICAL_FIRED=1
      ALERT_FIRED=1
    elif [[ "$lt_alert" == "true" && "$ALERT_FIRED" == 0 ]]; then
      alert_suffix="  ${C_BOLD}→ ALERT (health=${health_raw}% < ${ALERT_BELOW}%)${C_RESET}"
      notify "ccp-bruce alert" "healthPercent=$health_raw% (below $ALERT_BELOW%)"
      ALERT_FIRED=1
    fi

    if [[ "$lt_alert" == "false" && "$ALERT_FIRED" == 1 ]]; then
      printf '%s[%s] recovered → health=%s%%%s\n' "$C_BOLD" "$ts_human" "$health_raw" "$C_RESET"
      notify "ccp-bruce recovered" "health=$health_raw% (back above $ALERT_BELOW%)"
      ALERT_FIRED=0
      CRITICAL_FIRED=0
    fi
  fi

  printf '%s[%s] %s%s  %sHTTP %s · %4sms%s%s\n' \
    "$color" "$ts_human" "$health_display" "$C_RESET" \
    "$C_DIM" "$http_code" "$latency_ms" "$C_RESET" \
    "$alert_suffix"

  jq -cn \
    --arg ts "$ts_iso" \
    --argjson endpoint_status "$http_code" \
    --argjson endpoint_latency_ms "$latency_ms" \
    --argjson health_percent "$health_arg" \
    '{ts:$ts, endpoint_status:$endpoint_status, endpoint_latency_ms:$endpoint_latency_ms, health_percent:$health_percent}' \
    >> "$LOG_FILE"

  sleep "$INTERVAL"
done
