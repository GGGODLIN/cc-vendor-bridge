#!/usr/bin/env python3
# ccp-watch-render — stdin: NDJSON stream from `claude -p --output-format stream-json`
# stdout: human-readable live render of the agent loop.
#
# Robustness:
#   - Skips non-JSON lines (stderr leaks) without aborting the stream.
#   - Unknown event types render as faint breadcrumbs (`? <type>`) instead of silent drops.
#   - All system/<subtype> events render (not just init).
#   - EOF sentinel (`{"type":"ccp_watch_eof"}`) lets the upstream wrapper terminate
#     cleanly so the side pane returns to a normal prompt.

import json
import sys

DIM = "\033[2m"
BOLD = "\033[1m"
CYAN = "\033[36m"
YELLOW = "\033[33m"
MAGENTA = "\033[35m"
GREEN = "\033[32m"
RESET = "\033[0m"


def emit(text: str) -> None:
  sys.stdout.write(text)
  sys.stdout.flush()


def main() -> int:
  if hasattr(sys.stdin, "reconfigure"):
    sys.stdin.reconfigure(encoding="utf-8", errors="replace")
  if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
  while True:
    raw = sys.stdin.readline()
    if not raw:
      break
    line = raw.strip()
    if not line.startswith("{"):
      continue
    try:
      ev = json.loads(line)
    except json.JSONDecodeError:
      continue
    if not isinstance(ev, dict):
      continue

    ev_type = ev.get("type")
    if ev_type == "ccp_watch_eof":
      emit(f"{DIM}──── stream end ────{RESET}\n")
      return 0

    if ev_type == "system":
      subtype = ev.get("subtype") or "?"
      if subtype == "init":
        sid = str(ev.get("session_id") or "?")[:8]
        model = str(ev.get("model") or "?")
        cwd = str(ev.get("cwd") or "?")
        emit(
          f"\n{BOLD}{CYAN}┌─ ccp-watch ─────────────────────{RESET}\n"
          f"{DIM}│ session: {sid}…  model: {model}{RESET}\n"
          f"{DIM}│ cwd: {cwd}{RESET}\n"
          f"{BOLD}{CYAN}└─{RESET}\n"
        )
      else:
        detail = str(ev.get("hook_event_name") or ev.get("source") or "")
        if detail:
          emit(f"{DIM}· system/{subtype} {detail}{RESET}\n")
        else:
          emit(f"{DIM}· system/{subtype}{RESET}\n")
      continue

    if ev_type == "stream_event":
      event = ev.get("event")
      if not isinstance(event, dict):
        emit(f"{DIM}? stream_event/?{RESET}\n")
        continue
      et = event.get("type")
      if et == "content_block_start":
        cb = event.get("content_block")
        cb = cb if isinstance(cb, dict) else {}
        bt = cb.get("type") or "?"
        if bt == "thinking":
          emit(f"\n{MAGENTA}▶ thinking{RESET}\n  {DIM}")
        elif bt == "text":
          emit(f"\n{GREEN}▶ text{RESET}\n  ")
        elif bt == "tool_use":
          tname = str(cb.get("name") or "?")
          emit(f"\n{YELLOW}▶ tool: {BOLD}{tname}{RESET}\n  {DIM}")
        else:
          emit(f"\n{DIM}▶ {bt}{RESET}\n  ")
      elif et == "content_block_delta":
        delta = event.get("delta")
        delta = delta if isinstance(delta, dict) else {}
        dt = delta.get("type") or "?"
        if dt == "thinking_delta":
          emit(str(delta.get("thinking") or ""))
        elif dt == "text_delta":
          emit(str(delta.get("text") or ""))
        elif dt == "input_json_delta":
          emit(str(delta.get("partial_json") or ""))
        elif dt == "signature_delta":
          pass
        else:
          emit("…")
      elif et == "content_block_stop":
        emit(f"{RESET}\n")
      elif et == "message_stop":
        emit(f"{DIM}──── turn end ────{RESET}\n")
      elif et in ("message_start", "message_delta", "ping"):
        pass
      else:
        emit(f"{DIM}? stream_event/{et or '?'}{RESET}\n")
      continue

    if ev_type == "assistant":
      continue

    if ev_type == "result":
      dur_ms = ev.get("duration_ms") or 0
      num_turns = ev.get("num_turns") if ev.get("num_turns") is not None else "?"
      cost_val = ev.get("total_cost_usd")
      cost_num = float(cost_val) if isinstance(cost_val, (int, float)) else 0.0
      dur_num = float(dur_ms) / 1000.0 if isinstance(dur_ms, (int, float)) else 0.0
      subtype = str(ev.get("subtype") or "?")
      emit(
        f"\n{BOLD}{CYAN}┌─ result ({subtype}) ─────────────────{RESET}\n"
        f"{BOLD}{CYAN}│ {RESET}duration: {dur_num:.1f}s   turns: {num_turns}   cost: ${cost_num:.4f}\n"
        f"{BOLD}{CYAN}└─{RESET}\n"
      )
      continue

    if ev_type == "rate_limit_event":
      msg = ev.get("message")
      msg = msg if isinstance(msg, dict) else {}
      status = str(msg.get("status") or "?")
      rlt = str(msg.get("rateLimitType") or "?")
      emit(f"{DIM}[rate-limit: {status} / {rlt}]{RESET}\n")
      continue

    emit(f"{DIM}? {ev_type or 'no-type'}{RESET}\n")
  return 0


if __name__ == "__main__":
  try:
    raise SystemExit(main())
  except BrokenPipeError:
    raise SystemExit(0)
