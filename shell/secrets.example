#!/usr/bin/env bash
# Copy this to ~/.zsh_secrets, fill in your real keys, then chmod 600
# Then add to ~/.zshrc:  [[ -f ~/.zsh_secrets ]] && source ~/.zsh_secrets
#
# DO NOT commit the filled version. ~/.zsh_secrets should already be outside this repo,
# but keep it private.

# ===== DeepSeek =====
# Get key from: https://platform.deepseek.com/api_keys
# export DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Moonshot Kimi (international) =====
# Get key from: https://platform.kimi.ai/console/api-keys
# export MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Moonshot Kimi (大陸) — only set if you have a CN-issued key =====
# Get key from: https://platform.kimi.com/console
# export MOONSHOT_CN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Zhipu GLM (z.ai intl) =====
# Get key from: https://z.ai/manage-apikey/apikey-list
# export ZAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Zhipu GLM (大陸 bigmodel) — only set if you have a CN-issued key =====
# Get key from: https://open.bigmodel.cn/usercenter/apikeys
# export BIGMODEL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Alibaba DashScope (Singapore intl) =====
# Get key from: https://bailian.console.aliyun.com/?apiKey=1
# (intl version, account region must be Singapore — separate from mainland account)
# export DASHSCOPE_INTL_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Alibaba DashScope (大陸) — only set if you have a CN-issued key =====
# export DASHSCOPE_CN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Alibaba Qwen Coding Plan subscription =====
# Get key from: https://www.alibabacloud.com/help/en/model-studio/claude-code-coding-plan
# export QWEN_CODING_PLAN_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Xiaomi MiMo (intl PAYG) =====
# Get key from: https://platform.xiaomimimo.com/
# export MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Xiaomi MiMo Token Plan (Singapore subscription) =====
# Get key from: https://token-plan-sgp.xiaomimimo.com/
# export MIMO_SUB_API_KEY=tp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
